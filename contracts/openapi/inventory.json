{
  "openapi": "3.1.0",
  "info": {
    "title": "Market Inventory",
    "version": "1.0.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "santé"
        ],
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "santé"
        ],
        "summary": "Readyz",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/reservations": {
      "post": {
        "summary": "Reserve",
        "operationId": "reserve_v1_reservations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationResponse"
                }
              }
            }
          },
          "409": {
            "description": "Stock insuffisant ou réservation incompatible"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reservations/{order_id}/confirm": {
      "post": {
        "summary": "Confirm",
        "operationId": "confirm_v1_reservations__order_id__confirm_post",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Order Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Réservation inconnue"
          },
          "409": {
            "description": "Déjà libérée"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reservations/{order_id}/release": {
      "post": {
        "summary": "Release",
        "operationId": "release_v1_reservations__order_id__release_post",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Order Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "409": {
            "description": "Déjà confirmée"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/inventory/{sku}": {
      "get": {
        "summary": "Stock",
        "operationId": "stock_v1_inventory__sku__get",
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sku"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockResponse"
                }
              }
            }
          },
          "404": {
            "description": "Stock inconnu"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReservationLine": {
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "title": "Sku"
          },
          "quantity": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "sku",
          "quantity"
        ],
        "title": "ReservationLine"
      },
      "ReservationRequest": {
        "properties": {
          "order_id": {
            "type": "string",
            "minLength": 1,
            "title": "Order Id"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/ReservationLine"
            },
            "type": "array",
            "minItems": 1,
            "title": "Lines"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "lines"
        ],
        "title": "ReservationRequest"
      },
      "ReservationResponse": {
        "properties": {
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/ReservationLine"
            },
            "type": "array",
            "title": "Lines"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "status",
          "lines"
        ],
        "title": "ReservationResponse"
      },
      "Status": {
        "type": "string",
        "enum": [
          "RESERVED",
          "CONFIRMED",
          "RELEASED"
        ],
        "title": "Status"
      },
      "StockResponse": {
        "properties": {
          "sku": {
            "type": "string",
            "title": "Sku"
          },
          "available": {
            "type": "integer",
            "title": "Available"
          },
          "reserved": {
            "type": "integer",
            "title": "Reserved"
          }
        },
        "type": "object",
        "required": [
          "sku",
          "available",
          "reserved"
        ],
        "title": "StockResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
