# Copier ce fichier vers .env (jamais commité) et remplacer chaque valeur change-me-local. Aucune valeur réelle ici.

# --- PostgreSQL (une instance, un schéma et un rôle par service) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=market
POSTGRES_ADMIN_PASSWORD=change-me-local
AUTH_DB_PASSWORD=change-me-local
ORDERS_DB_PASSWORD=change-me-local
INVENTORY_DB_PASSWORD=change-me-local
PAYMENT_DB_PASSWORD=change-me-local
DELIVERY_DB_PASSWORD=change-me-local
REALTIME_DB_PASSWORD=change-me-local

# --- MongoDB ---
MONGO_URL=mongodb://mongo:27017/market

# --- Kafka (KRaft, 1 broker) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- MinIO (version figée dans le compose) ---
MINIO_ROOT_USER=minio-local
MINIO_ROOT_PASSWORD=change-me-local
S3_ENDPOINT=http://minio:9000

# --- Authentification ---
ENVIRONMENT=local
JWT_ISSUER=market-auth
JWT_AUDIENCE=market
JWT_TTL_SECONDS=900
# Échecs de connexion par e-mail, fenêtre glissante (secondes), vérifications Argon2 simultanées.
AUTH_MAX_FAILURES=10
AUTH_FAILURE_WINDOW_SECONDS=300
AUTH_FAILURE_MAX_ENTRIES=10000
AUTH_HASH_CONCURRENCY=2
AUTH_HASH_MAX_WAITING=16
AUTH_HASH_WAIT_TIMEOUT_SECONDS=0.25
AUTH_HASH_RETRY_AFTER_SECONDS=1
# Clés RS256 dans infra/secrets/ (ignoré par Git), par exemple :
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out infra/secrets/jwt_private.pem
#   openssl pkey -in infra/secrets/jwt_private.pem -pubout -out infra/secrets/jwt_public.pem
# Le compose lit la clé privée depuis sa copie sur tmpfs (/run/keys) ; cette valeur sert hors conteneur.
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

# --- Comptes de démonstration (développement uniquement) ---
DEMO_CLIENT_PASSWORD=change-me-local
DEMO_SELLER_PASSWORD=change-me-local
DEMO_OPS_PASSWORD=change-me-local

# --- Pseudonymisation (HMAC-SHA256) ---
PSEUDONYMIZATION_KEY=change-me-local

# --- Hypothèses métier réglables (à valider avec l'encadrant) ---
HUB_SATURATION_THRESHOLD=0.85
HUB_WINDOW_MINUTES=5
HUB_WATERMARK_MINUTES=10

# --- Observabilité ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
GRAFANA_ADMIN_PASSWORD=change-me-local
