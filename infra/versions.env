# Python : https://spark.apache.org/docs/3.5.5/ (Python 3.8+) ; projet >=3.12
PYTHON_VERSION=3.12.10
# Java : https://spark.apache.org/docs/3.5.5/ (Java 8/11/17)
JAVA_VERSION=17.0.14
# Spark : https://spark.apache.org/docs/3.5.5/
SPARK_VERSION=3.5.5
# Delta : https://docs.delta.io/releases/ (Delta 3.3.x avec Spark 3.5.x)
DELTA_VERSION=3.3.2
# Scala : https://github.com/apache/spark/blob/v3.5.5/pom.xml
SCALA_VERSION=2.12.18
# Connecteur Kafka Scala 2.12 : https://spark.apache.org/docs/3.5.5/structured-streaming-kafka-integration.html
SPARK_KAFKA_CONNECTOR_VERSION=3.5.5
# S3 : même Hadoop que Spark, https://github.com/apache/spark/blob/v3.5.5/pom.xml
HADOOP_AWS_VERSION=3.3.4
# Kafka JVM (scripts et bash) : https://hub.docker.com/r/apache/kafka
KAFKA_IMAGE_TAG=3.9.0
# MinIO archivé : dernière release amont, aucun service S0 ; disponibilité de l'image à valider en S5.
# https://github.com/minio/minio/releases/tag/RELEASE.2025-10-15T17-29-55Z
MINIO_IMAGE_TAG=RELEASE.2025-10-15T17-29-55Z
# PostgreSQL : https://hub.docker.com/_/postgres
POSTGRES_IMAGE_TAG=16.8-alpine
# MongoDB : https://hub.docker.com/_/mongo
MONGO_IMAGE_TAG=7.0.18
# NGINX : https://hub.docker.com/_/nginx
GATEWAY_IMAGE_TAG=1.28.0-alpine
